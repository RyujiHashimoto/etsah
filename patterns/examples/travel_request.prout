# 出張申請：上長の承認後、経理へメールで通知
app travel_request
  stack nextjs, postgres
  freedom guided

  entity TravelRequest
    id: Id
    applicant_email: Email
    destination: String
    purpose: String
    status: ApprovalStatus

  pattern auth
    provider: clerk
    roles: employee, manager, finance

  pattern approval TravelRequest
    entity: TravelRequest
    approver: manager
    on_approved: notify_finance

  pattern notify
    channel: email
    template: travel_approved

  custom notify_finance
    why "承認された出張申請に限り、経理の宛先を解決し、travel_approved テンプレートで通知する"
    lines 10
