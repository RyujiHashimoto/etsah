    {
      "name": "dispatch_contract",
      "version": "0.1.0",
      "intent": "派遣の個別契約と就業条件の明示を、開始日・終了日・抵触日つきで管理する",
      "tags": [
        "dispatch",
        "contract",
        "派遣契約",
        "個別契約",
        "就業条件明示",
        "抵触日",
        "期間制限"
      ],
      "slots": {
        "entity": {
          "required": true,
          "desc": "個別契約のエンティティ"
        },
        "staff": {
          "required": true,
          "desc": "派遣スタッフのエンティティ"
        },
        "client": {
          "required": true,
          "desc": "派遣先企業のエンティティ"
        },
        "start_date": {
          "required": true,
          "desc": "契約開始日。YYYY-MM-DD"
        },
        "end_date": {
          "required": true,
          "desc": "契約終了日。YYYY-MM-DD"
        },
        "conflict_date": {
          "required": true,
          "desc": "抵触日。YYYY-MM-DD。派遣先が通知した日を設定する"
        },
        "exempt": {
          "required": false,
          "desc": "期間制限の例外。none、無期雇用の indefinite、60歳以上の age60。例外でも法令判断はしない"
        }
      },
      "states": [],
      "effects": [
        "read(contracts)",
        "write(contracts)",
        "emit(audit)"
      ],
      "examples": [
        "examples/staffing.prout",
        "examples/staffing_desk.prout"
      ],
      "path": "registry/dispatch_contract.json",
      "field_types": {
        "start_date": "Date",
        "end_date": "Date",
        "conflict_date": "Date"
      },
      "constraints": [
        {
          "id": "start_on_or_before_end",
          "message": "contract start_date must be on or before end_date"
        },
        {
          "id": "end_on_or_before_conflict",
          "message": "contract end_date is after the 抵触日"
        }
      ]
    },
