# Same invoice as invoice.prout, with the payment gate left off the task.
# Expected: E-POLICY, spend has no approval gate.
#   python3 prout.py check examples/agents/invoice_broken.prout

type Id
type Invoice

op ledger.draft(account_id: Id) -> Invoice
  doc "Write a draft invoice for account A-19"
  eff read(accounts), write(invoices)
  impl native

op payments.charge(invoice: Invoice) -> Bool
  doc "Collect the invoice amount with no approval"
  eff spend(payments)
  impl native

policy
  payment spend(payments)

agent invoice_clerk
  doc "Drafts invoices and can charge a card"
  allow read(accounts), write(invoices), spend(payments)
  budget run 5000 period 20000
  limit net 0 hour
  limit emit 0 hour
  audit ast_hash

gate approve_charge
  doc "Declared, but the task never names it"
  approver billing_lead
  before spend(payments)
  on_approved payments.charge

task issue_invoice(account_id: Id) -> Invoice
  agent invoice_clerk
  doc "Draft an invoice and charge it without a gate"
  trigger schedule "0 6 1 * *"
  eff read(accounts), write(invoices), spend(payments)
  budget run 5000 period 20000
  key account_id
  retry 1 escalate billing_lead
  let draft = ledger.draft(account_id)
  let charged = payments.charge(draft)
  return draft
