        "操作履歴",
        "timeline",
        "監査ログ"
      ],
      "slots": {
        "entity": {
          "required": true,
          "desc": "対象の案件"
        },
        "events": {
          "required": true,
          "desc": "記録するイベント名"
        }
      },
      "states": [],
      "effects": [
        "write(events)",
        "read(events)"
      ],
      "examples": [
        "examples/repair_desk.prout",
        "examples/support_desk.prout"
      ],
      "path": "registry/activity_log.json"
    },
    {
      "name": "ai_task",
      "version": "0.1.0",
      "intent": "AIが決めた手順でエンティティを処理する。外部への送信、支払い、契約変更は人の承認が無いと仕様を通さない",
      "tags": [
        "ai",
        "agent",
        "task",
        "automation",
        "schedule",
        "webhook",
        "budget",
        "自動化",
        "タスク",
        "エージェント",
        "定期実行",
        "予算",
        "監査"
      ],
      "slots": {
        "entity": {
          "required": true,
          "desc": "タスクが読むエンティティ"
        },
        "trigger": {
          "required": true,
          "desc": "schedule（cron）、record（新しい行）、webhook（外部からの呼び出し）"
        },
        "schedule": {
          "required": false,
          "desc": "5欄の数値cron。trigger が schedule のときだけ書く"
        },
        "on_record": {
          "required": false,
          "desc": "行が増えたときに起動するエンティティ。trigger が record のときだけ書く"
        },
        "webhook": {
          "required": false,
          "desc": "受け口の名前。trigger が webhook のときだけ書く"
        },
        "steps": {
          "required": true,
          "desc": "手順。custom か、同じ仕様に適用済みのパターン名"
        },
        "effects": {
          "required": true,
          "desc": "AIが使ってよい効果。read, write, net, spend, emit"
        },
        "audience": {
          "required": true,
          "desc": "作用の相手。external は社外"
        },
        "approval": {
          "required": false,
          "desc": "approval_gate に付けた名前。外部への emit と net、spend、契約変更では必須"
        },
        "changes": {
          "required": false,
          "desc": "contract は契約の変更。承認ゲートが要る。省略は none"
        },
        "spend_per_run": {
          "required": true,
          "desc": "1回の実行で使ってよい spend の上限。円の整数。spend を使わないタスクは 0"
        },
        "spend_per_period": {
          "required": true,
          "desc": "period のあいだの spend 上限。1回の上限を下回ってはいけない"
        },
        "period": {
          "required": true,
          "desc": "spend 上限の期間"
        },
        "net_per_hour": {
          "required": true,
          "desc": "1時間あたりの net 回数。net を使わないタスクは 0"
        },
        "emit_per_hour": {
          "required": true,
          "desc": "1時間あたりの emit 回数。emit を使わないタスクは 0"
        },
        "retries": {
          "required": true,
          "desc": "失敗後の再試行回数。0以上5以下"
        },
        "escalate_to": {
          "required": true,
          "desc": "再試行が尽きたときに呼ぶ人のロール"
        },
        "idempotency_key": {
          "required": true,
          "desc": "同じキーの再実行を1回に畳むためのフィールド名"
        },
        "audit": {
          "required": true,
          "desc": "監査行に契約ASTのSHA-256を付ける。ast_hash だけを受け付ける"
        }
      },
      "states": [],
      "effects": [
        "read(entity)",
        "emit(audit)"
      ],
      "examples": [
        "examples/ai_automation.prout",
        "examples/ai_desk.prout"
      ],
      "path": "registry/ai_task.json",
      "automation": {
        "gates": [
          {
            "action": "emit",
            "message": "emit to an external party has no approval gate"
          },
          {
            "action": "net",
            "message": "net to an external party has no approval gate"
          },
          {
            "action": "spend",
            "message": "spend has no approval gate"
          }
        ],
        "change_message": "a contract change has no approval gate"
      }
    },
    {
      "name": "approval",
      "version": "0.3.0",
      "intent": "申請を承認者に回し、承認・差し戻し・却下の状態遷移を管理する。承認後の処理は on_approved フックで接続する",
      "tags": [
        "approval",
        "workflow",
        "request",
        "review",
        "申請",
        "承認",
        "差し戻し",
        "ワークフロー",
        "稟議"
      ],
      "slots": {
        "entity": {
          "required": true,
          "desc": "申請対象のエンティティ"
        },
        "approver": {
          "required": true,
          "desc": "承認ロール"
        },
        "on_approved": {
          "required": false,
          "desc": "承認後に呼ぶ処理（custom、または channel と recipient を渡す notify）"
        }
      },
      "states": [
        "draft",
        "pending",
        "approved",
        "returned",
        "rejected"
      ],
      "effects": [
        "write(approvals)",
        "notify(approver)",
        "emit(audit)"
      ],
      "examples": [
        "examples/expense.prout",
        "examples/travel_request.prout",
        "examples/equipment_purchase.prout",
        "bench/pc_lending.prout"
      ],
      "path": "registry/approval.json"
    },
    {
      "name": "approval_gate",
      "version": "0.1.0",
      "intent": "外部への送信、支払い、契約変更の前に人の承認を必須にし、承認後の処理へつなぐ",
      "tags": [
