# PC貸出：申請 → 承認 → 在庫引き当て
app pc_lending
  stack nextjs, postgres
  freedom guided

  entity Employee
    id: Id
    name: String
    email: Email

  entity PcRequest
    id: Id
    applicant: Employee
    model: String
    status: ApprovalStatus
    note: String

  pattern auth
    provider: clerk
    roles: employee, it_admin

  pattern crud PcRequests
    entity: PcRequest
    access: employee
    search: [id, status, model]
    paginate: 20

  pattern approval PcRequest
    entity: PcRequest
    approver: it_admin
    on_approved: allocate

  custom allocate
    why "承認後に在庫を引き当て、貸出期間を設定する"
    lines 35
