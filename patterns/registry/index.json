{
  "version": 1,
  "patterns": [
    {
      "name": "approval",
      "version": "0.3.0",
      "intent": "申請を承認者に回し、承認・差し戻し・却下の状態遷移を管理する。承認後の処理は on_approved フックで接続する",
      "tags": [
        "approval",
        "workflow",
        "request",
        "review",
        "申請",
        "承認",
        "差し戻し",
        "ワークフロー",
        "稟議"
      ],
      "slots": {
        "entity": {
          "required": true,
          "desc": "申請対象のエンティティ"
        },
        "approver": {
          "required": true,
          "desc": "承認ロール"
        },
        "on_approved": {
          "required": false,
          "desc": "承認後に呼ぶ処理（custom、または channel と recipient を渡す notify）"
        }
      },
      "states": [
        "draft",
        "pending",
        "approved",
        "returned",
        "rejected"
      ],
      "effects": [
        "write(approvals)",
        "notify(approver)",
        "emit(audit)"
      ],
      "examples": [
        "examples/expense.prout",
        "examples/travel_request.prout",
        "examples/equipment_purchase.prout",
        "bench/pc_lending.prout"
      ],
      "path": "registry/approval.json"
    },
    {
      "name": "auth",
      "version": "0.1.0",
      "intent": "サインイン、セッション、ロールによるルート保護を追加する",
      "tags": [
        "auth",
        "login",
        "session",
        "role",
        "認証",
        "ログイン",
        "権限"
      ],
      "slots": {
        "provider": {
          "required": true,
          "desc": "Clerk, Auth0, Supabase など"
        },
        "roles": {
          "required": false,
          "desc": "アプリで使うロール"
        }
      },
      "states": [],
      "effects": [
        "read(users)",
        "write(sessions)"
      ],
      "examples": [
        "examples/shop.prout",
        "examples/expense.prout"
      ],
      "path": "registry/auth.json"
    },
    {
      "name": "checkout",
      "version": "0.1.0",
      "intent": "決済セッション、Webhook、チェックアウト画面を追加する",
      "tags": [
        "checkout",
        "payment",
        "stripe",
        "webhook",
        "決済",
        "支払い"
      ],
      "slots": {
        "entity": {
          "required": true,
          "desc": "注文エンティティ"
        },
        "payment": {
          "required": true,
          "desc": "stripe など"
        },
        "success": {
          "required": false,
          "desc": "決済成功後の処理"
        },
        "cancel": {
          "required": false,
          "desc": "キャンセル時の戻り先"
        }
      },
      "states": [],
      "effects": [
        "write(orders)",
        "net(payment)"
      ],
      "examples": [
        "examples/shop.prout"
      ],
      "path": "registry/checkout.json"
    },
    {
      "name": "crud",
      "version": "0.1.0",
      "intent": "エンティティの一覧・詳細・作成・更新・削除を、管理画面とAPIで提供する",
      "tags": [
