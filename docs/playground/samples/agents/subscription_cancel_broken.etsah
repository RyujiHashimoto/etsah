# Same cancellation as subscription_cancel.etsah, with the contract gate left off.
# Expected: E-POLICY, a contract change has no approval gate.
#   python3 etsah.py check examples/agents/subscription_cancel_broken.etsah

type Id
type Subscription

op subscriptions.lookup(account_id: Id) -> Subscription
  doc "Read the current subscription"
  eff read(subscriptions)
  impl native

op subscriptions.cancel(subscription: Subscription) -> Bool
  doc "Write the cancellation with no approval"
  eff write(subscriptions)
  impl native

policy
  contract write(subscriptions)

agent subscription_desk
  doc "Can rewrite a subscription record"
  allow read(subscriptions), write(subscriptions)
  budget run 0 period 0
  limit net 0 hour
  limit emit 0 hour
  audit ast_hash

gate approve_cancel
  doc "Declared, but the task never names it"
  approver account_owner
  before write(subscriptions)
  on_approved subscriptions.cancel

task cancel_subscription(account_id: Id) -> Bool
  agent subscription_desk
  doc "Cancel plan_basic without a contract gate"
  trigger webhook "cancel-subscription"
  eff read(subscriptions), write(subscriptions)
  key account_id
  retry 0 escalate account_owner
  let subscription = subscriptions.lookup(account_id)
  let cancelled = subscriptions.cancel(subscription)
  return cancelled
