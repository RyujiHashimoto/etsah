# Lantern Yard Desk, fictional. One program holds both policies:
# an information-flow sink for pii, and an agent policy that marks net(email)
# as external. The task names a gate before the receipt is sent.
#
#   python3 etsah.py check examples/combined_policy_safe.etsah --allow-net email
#
# Expected: exit 0.

label pii

type Id
type Customer {
  id: Id
  email: String @pii
}

policy
  sink net(email) accepts pii

policy
  external net(email)

op customers.get(id: Id) -> Customer
  doc "Read fictional customer C-17 at Lantern Yard"
  eff read(customers)
  impl native

op send_receipt(to: String @pii) -> Bool
  doc "Send a receipt to the customer's own address"
  eff net(email)
  sends to -> net(email)
  impl native

agent lantern_mail
  doc "Sends an approved receipt and nothing else"
  allow read(customers), net(email)
  budget run 0 period 0
  limit net 5 hour
  limit emit 0 hour
  audit ast_hash

gate approve_receipt
  doc "A desk lead approves the receipt"
  approver desk_lead
  before net(email)
  on_approved send_receipt

task send_receipt_task(customer_id: Id) -> Bool
  agent lantern_mail
  doc "Send the C-17 receipt after approval"
  trigger schedule "0 9 * * 1"
  eff read(customers), net(email)
  gate approve_receipt
  key customer_id
  retry 1 escalate desk_lead
  let customer = customers.get(customer_id)
  let sent = send_receipt(customer.email)
  return sent
