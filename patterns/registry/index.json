      "slots": {
        "entity": {
          "required": true,
          "desc": "承認対象のエンティティ"
        },
        "approver": {
          "required": true,
          "desc": "承認する人のロール"
        },
        "action": {
          "required": true,
          "desc": "人が許可する作用。emit、net、spend、contract"
        },
        "audience": {
          "required": true,
          "desc": "作用の相手。タスクの audience と一致させる"
        },
        "on_approved": {
          "required": false,
          "desc": "承認後に呼ぶ処理。custom か適用済みパターン"
        }
      },
      "states": [
        "pending",
        "approved",
        "rejected"
      ],
      "effects": [
        "write(approvals)",
        "emit(audit)"
      ],
      "examples": [
        "examples/ai_automation.prout",
        "examples/ai_desk.prout"
      ],
      "path": "registry/approval_gate.json",
      "requires_target": true
    },
