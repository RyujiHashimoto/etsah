{
  "name": "survey",
  "version": "0.1.0",
  "intent": "対応を終えた案件に評価を記録して集計する",
  "tags": [
    "survey",
    "満足度調査",
    "feedback",
    "アンケート"
  ],
  "slots": {
    "entity": {
      "type": "entity",
      "required": true,
      "desc": "対象の案件"
    },
    "scale": {
      "type": "int",
      "required": true,
      "desc": "評価段階数"
    }
  },
  "effects": [
    "write(responses)",
    "read(responses)"
  ],
  "artifacts": [
    {
      "path": "lib/{plural}/survey.ts",
      "kind": "TS",
      "lines": 35,
      "desc": "{Entity}の評価の受付と集計"
    },
    {
      "path": "tests/{plural}/survey.test.ts",
      "kind": "TEST",
      "lines": 25,
      "desc": "範囲外の評価の拒否"
    }
  ],
  "examples": [
    "examples/repair_desk.prout",
    "examples/support_desk.prout"
  ],
  "provenance": {
    "author": "OpenAI Codex",
    "date": "2026-11-22",
    "extracted_from": [
      "repair_desk",
      "support_desk"
    ],
    "note": "修理受付とサポート窓口の合成仕様例から共通化。行数は概算。"
  }
}
