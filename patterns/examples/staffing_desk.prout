# 短期案件のデスク。同じ派遣パターンを別の単価・期間で再利用する合成例。
# 日次の時間外上限 7.5 は協定の設定であり、法定の1日の上限ではない。月45時間とは比べない。
# 特別条項は付けない。抵触日は 2026-06-01 の3年後である 2029-06-01。

app staffing_desk
  stack nextjs, postgres
  freedom guided

  entity Staff
    id: Id
    name: String
    skills: String
    insured: String

  entity Client
    id: Id
    name: String

  entity Opening
    id: Id
    client: Client
    title: String
    required_skills: String

  entity DispatchContract
    id: Id
    staff: Staff
    client: Client
    duties: String
    workplace: String
    start_date: Date
    end_date: Date
    conflict_date: Date
    status: String

  entity Timesheet
    id: Id
    contract: DispatchContract
    work_date: Date
    hours: Duration
    status: String

  entity OvertimeAgreement
    id: Id
    status: String

  entity Invoice
    id: Id
    client: Client
    bill_rate: Rate
    pay_rate: Rate
    hours: Duration
    amount: Money
    status: String

  pattern matching
    staff: Staff
    opening: Opening
    skills: skills

  pattern dispatch_contract
    entity: DispatchContract
    staff: Staff
    client: Client
    start_date: 2026-06-01
    end_date: 2026-08-31
    conflict_date: 2029-06-01
    exempt: none

  pattern timesheet
    entity: Timesheet
    approver: client_supervisor
    period: daily
    overtime_cap_hours: 7.5

  pattern overtime_agreement
    entity: OvertimeAgreement
    timesheet: Timesheet
    special_clause: none
    warn_at_hours: 30
    on_warning: notify
    on_limit: reject

  pattern staffing_billing
    entity: Invoice
    timesheet: Timesheet
    bill_rate: 3200.50
    pay_rate: 2100

  custom spot_margin
    why "単発案件の粗利を、社会保険料を含まない時間単価の差として人が確認する。料率テーブルは持たない"
    lines 20
