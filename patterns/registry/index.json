{
  "version": 1,
  "patterns": [
    {
      "name": "approval",
      "version": "0.2.0",
      "intent": "申請を承認者に回し、承認・差し戻し・却下の状態遷移を管理する。承認後の処理は on_approved フックで接続する",
      "tags": [
        "approval",
        "workflow",
        "request",
        "review",
        "申請",
        "承認",
        "差し戻し",
        "ワークフロー",
        "稟議"
      ],
      "slots": {
        "entity": {
          "required": true,
          "desc": "申請対象のエンティティ"
        },
        "approver": {
          "required": true,
          "desc": "承認ロール"
        },
        "on_approved": {
          "required": false,
          "desc": "承認後に呼ぶ処理（custom または別パターン）"
        }
      },
      "states": [
        "draft",
        "pending",
        "approved",
        "returned",
        "rejected"
      ],
      "effects": [
        "write(approvals)",
        "notify(approver)",
        "emit(audit)"
      ],
      "examples": [
        "examples/expense.prout",
        "examples/travel_request.prout",
        "examples/equipment_purchase.prout",
        "bench/pc_lending.prout"
      ],
      "path": "registry/approval.json"
    },
    {
