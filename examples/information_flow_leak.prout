# Information flow, leaking version: the PII e-mail address is passed to a
# public analytics parameter. The checker must reject this file.
#
#   python3 prout.py check examples/information_flow_leak.prout \
#     --allow-net email --allow-net analytics
#
# Expected: E-IFLOW-ARG at the track_event call.

label pii
label secret

type Id
type Customer {
  id: Id
  email: String @pii
  internal_note: String @secret
}

policy
  sink net(email) accepts pii
  sink net(*) rejects secret

op customers.get(id: Id) -> Customer
  doc "顧客を一件取得する"
  eff read(customers)
  impl native

op track_event(event: String) -> Bool
  doc "分析イベントを送る"
  eff net(analytics)
  sends event -> net(analytics)
  impl native

flow leak_email(id: Id) -> Bool
  doc "顧客のメールアドレスをそのまま分析に送ってしまう"
  eff read(customers), net(analytics)
  let c = customers.get(id)
  return track_event(c.email)
