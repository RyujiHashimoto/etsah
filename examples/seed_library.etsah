# Maple Shelf: look up packet MS-204 and record the loan.
#
#   python3 etsah.py check examples/seed_library.etsah
#
# Expected: exit 0.

type PacketId
type Packet {
  id: PacketId
  name: String
}

op shelf.lookup(id: PacketId) -> Packet
  doc "Look up fictional packet MS-204 on the Maple Shelf"
  eff read(catalog)
  impl native

op loans.record(packet: Packet) -> Bool
  doc "Record that Maple Shelf packet MS-204 went out on loan"
  eff write(loans)
  impl native

flow lend_packet(id: PacketId) -> Bool
  eff read(catalog), write(loans)
  let packet = shelf.lookup(id)
  let recorded = loans.record(packet)
  return recorded
