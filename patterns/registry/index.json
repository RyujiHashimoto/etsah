    {
      "name": "staffing_billing",
      "version": "0.1.0",
      "intent": "承認済みの勤怠から派遣先請求とスタッフ給与を起こし、請求単価が支払単価を下回らないことを検査する",
      "tags": [
        "invoice",
        "payroll",
        "billing",
        "margin",
        "請求",
        "給与",
        "粗利",
        "マージン",
        "単価"
      ],
      "slots": {
        "entity": {
          "required": true,
          "desc": "請求エンティティ"
        },
        "timesheet": {
          "required": true,
          "desc": "集計元の勤怠エンティティ"
        },
        "bill_rate": {
          "required": true,
          "desc": "派遣先への請求時間単価（円）。小数可"
        },
        "pay_rate": {
          "required": true,
          "desc": "スタッフへの支払時間単価（円）。小数可"
        }
      },
      "states": [],
      "effects": [
        "read(timesheets)",
        "write(invoices)",
        "write(payroll)",
        "emit(audit)"
      ],
      "examples": [
        "examples/staffing.prout",
        "examples/staffing_desk.prout"
      ],
      "path": "registry/staffing_billing.json",
      "field_types": {
        "bill_rate": "Rate",
        "pay_rate": "Rate",
        "hours": "Duration"
      },
      "constraints": [
        {
          "id": "bill_gte_pay",
          "message": "bill rate is below pay rate"
        }
      ],
      "requires_patterns": [
        "timesheet"
      ]
    },
    {
      "name": "timesheet",
      "version": "0.1.0",
      "intent": "スタッフの勤怠を提出し、派遣先の承認を経てから請求と給与に回す",
      "tags": [
        "timesheet",
        "attendance",
        "勤怠",
        "タイムシート",
        "勤怠承認",
        "派遣先",
        "残業",
        "36協定"
      ],
      "slots": {
        "entity": {
          "required": true,
          "desc": "勤怠エンティティ"
        },
        "approver": {
          "required": true,
          "desc": "派遣先の承認ロール。無い勤怠は請求に回せない"
        },
        "on_approved": {
          "required": false,
          "desc": "派遣先の承認後に呼ぶ処理（請求起票など）"
        },
        "period": {
          "required": false,
          "desc": "daily または monthly。既定は monthly"
        },
        "overtime_cap_hours": {
          "required": false,
          "desc": "36協定で定めた時間外の上限（時間）。法定の数値は入れない"
        }
      },
      "states": [
        "draft",
        "submitted",
        "client_approved",
        "returned"
      ],
      "effects": [
        "read(timesheets)",
        "write(timesheets)",
        "notify(approver)",
        "emit(audit)"
      ],
      "examples": [
        "examples/staffing.prout",
        "examples/staffing_desk.prout"
      ],
      "path": "registry/timesheet.json",
      "field_types": {
        "work_date": "Date",
        "hours": "Duration"
      },
      "constraints": [
        {
          "id": "overtime_cap_non_negative",
          "message": "overtime cap must be zero or a positive number of hours"
        }
      ]
    },
