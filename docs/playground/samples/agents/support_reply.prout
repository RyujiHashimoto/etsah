# Customer-support reply drafting for a fictional desk, Harbor Lane Support.
# Reading a ticket stays inside the desk. Emailing the customer is external
# and needs an approval gate. Nothing here sends a live message.
#   python3 prout.py check examples/agents/support_reply.prout

type Id
type Ticket

op tickets.read(ticket_id: Id) -> Ticket
  doc "Read ticket T-1042 for Mina Patel"
  eff read(tickets)
  impl native

op mail.send_reply(ticket: Ticket) -> Bool
  doc "Send the approved reply to the customer"
  eff emit(mail)
  impl native

policy
  external emit(mail)

agent support_reply
  doc "Drafts replies and sends mail only after a person approves"
  allow read(tickets), emit(mail)
  budget run 0 period 0
  limit net 0 hour
  limit emit 20 hour
  audit ast_hash

gate approve_reply
  doc "A support lead approves the reply before it is emailed"
  approver support_lead
  before emit(mail)
  on_approved mail.send_reply

task draft_reply(ticket_id: Id) -> Bool
  agent support_reply
  doc "Read a ticket and send the reply through the approval gate"
  trigger webhook "support-tickets"
  eff read(tickets), emit(mail)
  gate approve_reply
  key ticket_id
  retry 2 escalate support_lead
  let ticket = tickets.read(ticket_id)
  let sent = mail.send_reply(ticket)
  return sent
