# 抵触日の自動計算と、特別条項なしの36協定。エラー 0。
# 2024-02-29 開始の抵触日は 2027-03-01（応当日が無いので満了日の翌日）。
# 2021-07-02 開始は、直前終了 2021-03-31 から 3か月+1日空くので起算をリセットする。
# 2026-04-01 開始は、直前終了 2026-03-31 の翌日なので通算し、抵触日は 2027-04-01。

app staffing_limits
  stack nextjs, postgres
  freedom guided

  entity Staff
    id: Id
    name: String

  entity Client
    id: Id
    name: String

  entity DispatchContract
    id: Id
    staff: Staff
    client: Client
    duties: String
    workplace: String
    start_date: Date
    end_date: Date
    conflict_date: Date
    office: String
    org_unit: String
    person: String
    status: String

  entity Timesheet
    id: Id
    contract: DispatchContract
    work_date: Date
    hours: Duration
    overtime_hours: Duration
    status: String

  entity OvertimeAgreement
    id: Id
    status: String

  pattern dispatch_contract LeapTerm
    entity: DispatchContract
    staff: Staff
    client: Client
    start_date: 2024-02-29
    end_date: 2027-02-28
    conflict_date: 2027-03-01
    office: osaka-leap
    org_unit: accounting
    person: leap-person

  pattern dispatch_contract CooledTerm
    entity: DispatchContract
    staff: Staff
    client: Client
    start_date: 2021-07-02
    end_date: 2022-03-31
    conflict_date: 2024-07-02
    office: osaka-cooled
    org_unit: sales
    person: cooled-person
    office_history: 2020-04-01/2021-03-31

  pattern dispatch_contract ContinuedTerm
    entity: DispatchContract
    staff: Staff
    client: Client
    start_date: 2026-04-01
    end_date: 2027-03-31
    conflict_date: 2027-04-01
    office: tokyo-continued
    org_unit: general
    person: continued-person
    office_history: 2024-04-01/2026-03-31

  pattern timesheet
    entity: Timesheet
    approver: client_approver
    period: monthly
    overtime_cap_hours: 45

  pattern overtime_agreement
    entity: OvertimeAgreement
    timesheet: Timesheet
    special_clause: none
    warn_at_hours: 30
    on_warning: notify
    on_limit: reject
